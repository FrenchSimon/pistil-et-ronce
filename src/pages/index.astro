---
import Base from '../layouts/Base.astro';
import Accroche from '../components/Accroche.astro';
import Prestations from '../components/Prestations.astro';
import FaconDeFaire from '../components/FaconDeFaire.astro';
import Realisations from '../components/Realisations.astro';
import Avis from '../components/Avis.astro';
import NousTrouver from '../components/NousTrouver.astro';

const title = 'Pistil & Ronce — Fleuriste à Nantes · bouquets, mariages, livraison';
const description =
  "Fleuriste artisanale à Nantes. Bouquets du jour de saison, fleurs de mariage et d'événement, abonnements pour entreprises et livraison dans Nantes et alentours.";
---

<Base title={title} description={description}>
  <Accroche />
  <Prestations />
  <FaconDeFaire />
  <Realisations />
  <Avis />
  <NousTrouver />
</Base>
