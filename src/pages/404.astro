---
import Base from '../layouts/Base.astro';
import FleurFanee from '../assets/deco/fleur-fanee.svg';

/* Textes de docs/textes.md § 12 */
const title = 'Page introuvable — Pistil & Ronce (démo)';
const description =
  "Cette page n'existe pas sur le site de démonstration Pistil & Ronce, boutique fictive à Nantes.";
---

<Base title={title} description={description}>
  <section class="introuvable conteneur" aria-labelledby="introuvable-titre">
    <FleurFanee class="introuvable__illustration" aria-hidden="true" />
    <p class="introuvable__surtitre etiquette">Erreur 404</p>
    <h1 id="introuvable-titre" class="introuvable__titre">Cette page a fané</h1>
    <p class="introuvable__texte">La page que vous cherchez n'existe pas ou a été déplacée.</p>
    <a class="bouton-principal introuvable__bouton" href="/">
      Retour à l'accueil
      <svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M1 6 Q9 -1 17 6 Q9 13 1 6 Z M3 6 H14"></path></svg>
    </a>
  </section>
</Base>

<style>
  .introuvable {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: calc(560px + 2 * var(--marge-laterale));
    padding-block: var(--espace-section);
    text-align: center;
  }

  .introuvable__illustration {
    width: 100%;
    max-width: 360px;
    height: auto;
  }

  .introuvable__surtitre {
    margin-top: var(--pas-4);
    color: var(--sapin-doux);
  }

  .introuvable__titre {
    margin-top: var(--pas-2);
    font-size: clamp(40px, 6vw, 56px);
    line-height: 1.05;
    text-wrap: balance;
  }

  .introuvable__texte {
    margin-top: var(--pas-3);
    font-size: 18px;
    text-wrap: balance;
  }

  .introuvable__bouton {
    margin-top: var(--pas-4);
  }
</style>
