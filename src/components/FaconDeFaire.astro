---
const points = [
  {
    titre: 'De saison\u00a0:',
    texte: 'pas de roses en janvier. Ce qui pousse en ce moment, au meilleur de sa forme.',
  },
  {
    titre: "D'ici\u00a0:",
    texte: "la plupart de nos fleurs viennent de producteurs de Loire-Atlantique et de l'Anjou.",
  },
  {
    titre: 'Sans plastique\u00a0:',
    texte: 'emballage en papier kraft et raphia.',
  },
];
---

<section class="facon" aria-labelledby="facon-titre">
  <div class="conteneur">
    <h2 id="facon-titre">Notre façon de faire</h2>

    <ul class="facon__points liste-nue">
      {points.map(({ titre, texte }) => (
        <li>
          <svg class="facon__puce" width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M1 6 Q9 -1 17 6 Q9 13 1 6 Z M3 6 H14"></path></svg>
          <p>
            <strong>{titre}</strong>
            {texte}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .facon {
    padding-block: var(--espace-section);
    border-block: 1px solid var(--lin);
    background: var(--papier-clair);
  }

  h2 {
    font-size: clamp(32px, 3vw, 40px);
    line-height: 1.1;
  }

  .facon__points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--pas-4) var(--pas-3);
    margin-top: var(--pas-4);
  }

  .facon__points li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  /* Puce feuille B en sauge, décalée de 7 px vers le bas */
  .facon__puce {
    flex-shrink: 0;
    margin-top: 7px;
    color: var(--sauge);
  }

  .facon__points p {
    font-size: 17px;
    line-height: 1.6;
  }

  .facon__points strong {
    display: block;
    margin-bottom: 4px;
    font-family: var(--police-titre);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
  }
</style>
