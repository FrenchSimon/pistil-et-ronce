---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import bouquets from '../../contenu/photos/prestation-bouquets-du-jour.jpg';
import mariages from '../../contenu/photos/prestation-mariages.jpg';
import abonnements from '../../contenu/photos/prestation-abonnements.jpg';
import Branche from '../assets/deco/branche-livraison.svg';

interface Prestation {
  titre: string;
  texte: string;
  prix: string;
  photo?: ImageMetadata;
}

const prestations: Prestation[] = [
  {
    titre: 'Bouquets du jour',
    texte:
      'Composés chaque matin selon les arrivages. À emporter en boutique ou à commander la veille.',
    prix: 'à partir de 30\u00a0€',
    photo: bouquets,
  },
  {
    titre: 'Mariages et événements',
    texte:
      'Bouquet de la mariée, boutonnières, centres de table, arche. On se rencontre pour imaginer ensemble votre décor.',
    prix: 'sur devis',
    photo: mariages,
  },
  {
    titre: 'Abonnements entreprises',
    texte:
      "Des fleurs fraîches à l'accueil ou en salle de réunion, renouvelées chaque semaine ou toutes les deux semaines.",
    prix: 'à partir de 25\u00a0€\u00a0/ semaine',
    photo: abonnements,
  },
  {
    titre: 'Livraison locale',
    texte:
      'Livraison du mardi au samedi dans Nantes et les communes voisines, avec un mot écrit à la main.',
    prix: 'à partir de 8\u00a0€',
  },
];
---

<section id="prestations" class="prestations" aria-labelledby="prestations-titre">
  <div class="conteneur">
    <h2 id="prestations-titre">Ce que nous faisons</h2>

    <ul class="prestations__grille liste-nue">
      {prestations.map(({ titre, texte, prix, photo }) => (
        <li class="carte">
          {photo ? (
            <Picture
              src={photo}
              formats={['avif', 'webp']}
              widths={[320, 480, 640, 960]}
              sizes="(min-width: 1440px) 310px, (min-width: 1150px) calc((100vw - 232px) / 4), (min-width: 600px) calc((100vw - 120px) / 2), calc(100vw - 40px)"
              width={960}
              height={600}
              fit="cover"
              alt=""
              class="carte__photo"
            />
          ) : (
            <div class="carte__decor" aria-hidden="true">
              <Branche />
            </div>
          )}
          <div class="carte__corps">
            <h3>{titre}</h3>
            <p>{texte}</p>
            <p class="carte__prix etiquette">{prix}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Fond opaque et positionné : la section passe devant le décor de l'accroche, qui ne déborde plus sous le titre */
  .prestations {
    position: relative;
    padding-bottom: var(--espace-section);
    background: var(--papier);
  }

  h2 {
    font-size: clamp(32px, 3vw, 40px);
    line-height: 1.1;
  }

  .prestations__grille {
    display: grid;
    gap: var(--pas-3);
    margin-top: var(--pas-4);
  }

  /* 1, 2 puis 4 colonnes : jamais de carte seule sur sa ligne (auto-fit donnait 3 + 1 vers 1 000 px) */
  @media (min-width: 600px) {
    .prestations__grille {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1150px) {
    .prestations__grille {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .carte {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--lin);
    background: var(--papier-clair);
  }

  .carte :global(.carte__photo),
  .carte__decor {
    width: 100%;
    height: 240px;
  }

  .carte :global(.carte__photo) {
    object-fit: cover;
  }

  .carte__decor {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--papier);
  }

  .carte__corps {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px 24px 26px;
  }

  h3 {
    font-size: 26px;
    line-height: 32px;
  }

  .carte__corps p {
    margin-top: var(--pas-1);
  }

  /* Le prix descend en bas de la carte : les filets restent alignés d'une carte à l'autre */
  .carte__corps .carte__prix {
    margin-top: auto;
    padding-top: var(--pas-2);
    border-top: 1px solid var(--lin);
  }

  .carte__corps p:not(.carte__prix) {
    margin-bottom: var(--pas-3);
  }
</style>
