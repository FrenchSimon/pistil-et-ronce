---
import FlecheSortante from './FlecheSortante.astro';

interface Avis {
  citation: string;
  auteur: string;
  contexte: string;
}

/* Textes de docs/textes.md § 7 ; le guillemet ouvrant est dessiné en décor */
const avis: Avis[] = [
  {
    citation: "Le bouquet était encore plus beau qu'en photo, et il a tenu presque deux semaines.",
    auteur: 'Claire M.',
    contexte: "bouquet d'anniversaire",
  },
  {
    citation: 'Elle a compris notre idée dès le premier rendez-vous. Les fleurs du mariage étaient parfaites.',
    auteur: 'Julien et Sarah',
    contexte: 'mariage en juin',
  },
  {
    citation: "Nos clients nous parlent des fleurs de l'accueil chaque semaine.",
    auteur: "Cabinet d'architectes",
    contexte: 'abonnement entreprise',
  },
];
---

<section id="avis" class="avis" aria-labelledby="avis-titre">
  <div class="conteneur">
    <h2 id="avis-titre">Ils nous ont fait confiance</h2>

    <ul class="avis__grille liste-nue">
      {avis.map(({ citation, auteur, contexte }) => (
        <li>
          <figure class="avis__carte">
            <span class="avis__guillemet" aria-hidden="true">«</span>
            <blockquote>
              <p>{citation}</p>
            </blockquote>
            <figcaption>
              <strong>{auteur}</strong>, {contexte}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <p class="avis__mention">Avis fictifs (démo).</p>

    {/* Sur un vrai site : lien vers la fiche Google, en nouvel onglet. Ici la fiche n'existe pas, donc texte simple. */}
    <p class="avis__google">
      <span>Lire tous nos avis sur Google<FlecheSortante /></span>
      <span class="etiquette-fictif">fictif</span>
    </p>
  </div>
</section>

<style>
  .avis {
    padding-block: var(--espace-section);
    border-block: 1px solid var(--lin);
    background: var(--papier-clair);
  }

  h2 {
    font-size: clamp(32px, 3vw, 40px);
    line-height: 1.1;
  }

  .avis__grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--pas-3);
    margin-top: var(--pas-4);
  }

  /* Carte sur fond papier, pour se détacher de la bande papier clair */
  .avis__carte {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 26px;
    border: 1px solid var(--lin);
    background: var(--papier);
  }

  /* Le glyphe se dessine bas dans sa ligne : boîte réduite pour qu'il touche presque la citation */
  .avis__guillemet {
    height: 30px;
    margin: -6px 0 8px;
    color: var(--pivoine-pale);
    font-family: var(--police-titre);
    font-size: 64px;
    font-style: italic;
    font-weight: 600;
    line-height: 0.6;
  }

  blockquote {
    flex-grow: 1;
    font-family: var(--police-titre);
    font-size: 21px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.4;
  }

  @media (min-width: 900px) {
    blockquote {
      font-size: 23px;
    }
  }

  figcaption {
    margin-top: var(--pas-3);
    padding-top: var(--pas-2);
    border-top: 1px solid var(--lin);
    color: var(--sapin-doux);
    font-size: 15px;
  }

  figcaption strong {
    color: var(--sapin);
    font-weight: 600;
  }

  .avis__google {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: var(--pas-2);
    font-weight: 600;
  }

  .etiquette-fictif {
    color: var(--sapin-doux);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .avis__mention {
    margin-top: var(--pas-3);
    color: var(--sapin-doux);
    font-size: 15px;
    font-style: italic;
  }
</style>
